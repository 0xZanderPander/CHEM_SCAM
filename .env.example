NODE_ENV=production
SITE_URL=https://example.com
SITE_DOMAIN=example.com

POSTGRES_DB=chem_scam
POSTGRES_USER=chem_scam
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://chem_scam:replace-with-a-long-random-password@postgres:5432/chem_scam
DATABASE_POOL_MAX=10

ADMIN_PASSWORD=replace-with-a-long-random-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
CONFIRMATION_SECRET=replace-with-at-least-32-random-characters
RATE_LIMIT_SECRET=replace-with-at-least-32-random-characters

RATE_LIMIT_REPORTS_PER_HOUR=5
RATE_LIMIT_COMMENTS_PER_HOUR=20
RATE_LIMIT_CONFIRMATIONS_PER_HOUR=30
RATE_LIMIT_CONFIRMATIONS_PER_REPORT_HOUR=5
RATE_LIMIT_FLAGS_PER_HOUR=20
RATE_LIMIT_ADMIN_LOGINS_PER_15_MIN=5
RATE_LIMIT_DISPUTES_PER_HOUR=5
MIN_SUBMISSION_TIME_MS=1500

BACKUP_ENCRYPTION_RECIPIENT=
BACKUP_RETENTION_DAYS=14
BACKUP_DIR=./backups

